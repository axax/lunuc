{
  "types": [
    {
      "name": "Log",
      "subscription": false,
      "access": {
        "create": "anonymous"
      },
      "onlyRequestedFields": true,
      "addMetaDataInQuery": false,
      "fields": [
        {
          "type": "String",
          "name": "message",
          "uitype": "editor",
          "alwaysLoad": false,
          "tab": "General"
        },
        {
          "name": "type",
          "index": 1,
          "tab": "General"
        },
        {
          "name": "location",
          "index": 1,
          "tab": "General"
        },
        {
          "name": "server",
          "index": 1,
          "tab": "General"
        },
        {
          "name": "meta",
          "type": "Object",
          "uitype": "json",
          "hideColumnInTypes": true,
          "alwaysLoad": false,
          "tab": "Details"
        },
        {
          "name":"solution",
          "uitype": "htmlParser",
          "replacePlaceholders":true,
          "html":"<iframe src=\"/system/aiassistent?promtTemplate=lunuc_log&input=${ encodeURIComponent(   'message: ' + valuesOri.message + '\\n' +  'type: ' + valuesOri.type + '\\n' +  'location: ' + valuesOri.location + '\\n' + 'details: ' + JSON.stringify(valuesOri.meta))}\" frameborder=\"0\" width=\"100%\" height=\"300px\" />",
          "tab": "KI assistant",
          "access": {
            "ui": {
              "role": "admin_options"
            }
          }
        }
      ]
    }
  ]
}
